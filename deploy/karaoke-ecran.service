[Unit]
Description=Ecran karaoke sur la TV (kiosque plein ecran)
After=pikaraoke.service systemd-user-sessions.service
Wants=pikaraoke.service

[Service]
User=alexy
# PAM login session gives the process seat access (DRM/input) without X
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/home/alexy/karaoke/deploy/lancer-ecran.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
